module mux_8_1(
    input[7:0] i;
    input[2:0] s;
    output reg o;
);
    always @(s or i)
    begin
        case(s)
            3b'000: o = i[0];
            3b'001: o = i[1];
            3b'010: o = i[2];
            3b'011: o = i[3];
            3b'100: o = i[4];
            3b'101: o = i[5];
            3b'110: o = i[6];
            3b'111: o = i[7];
            default: o = 1'bx;
        endcase
        end
endmodule
